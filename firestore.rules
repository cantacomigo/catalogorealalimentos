rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stock/{productId} {
      allow read, write: if true;
    }
    match /stock_logs/{logId} {
      allow read, write: if true;
    }
    match /sales_reps/{repId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /product_customizations/{customId} {
      allow read, write: if true;
    }
    match /catalog_customizations/{customId} {
      allow read, write: if true;
    }
  }
}
