{
  "entities": {
    "ProductStock": {
      "title": "ProductStock",
      "description": "Real-time inventory and price/image customization for a catalog product",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "ID do produto correspondente" },
        "stockQuantity": { "type": "number", "description": "Quantidade atual disponível em estoque" },
        "minStockAlert": { "type": "number", "description": "Limite mínimo para alerta de estoque baixo" },
        "unit": { "type": "string", "description": "Unidade de medida de estoque (unidade, caixa, fardo)" },
        "isUnlimited": { "type": "boolean", "description": "Se o estoque é ilimitado ou controlado" },
        "lastUpdated": { "type": "string", "description": "Data e hora da última alteração" },
        "customPrice": { "type": "number", "description": "Preço personalizado sincronizado" },
        "customImage": { "type": "string", "description": "Foto personalizada do produto" }
      },
      "required": ["productId", "stockQuantity"]
    },
    "CustomProduct": {
      "title": "CustomProduct",
      "description": "Custom or edited catalog product created by the administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único do produto" },
        "name": { "type": "string", "description": "Nome comercial do produto" },
        "brand": { "type": "string", "description": "Identificador da marca" },
        "brandName": { "type": "string", "description": "Nome de exibição da marca" },
        "category": { "type": "string", "description": "Categoria do produto" },
        "weight": { "type": "string", "description": "Peso ou volume" },
        "packageType": { "type": "string", "description": "Tipo de embalagem" },
        "description": { "type": "string", "description": "Descrição comercial do produto" },
        "temperature": { "type": "string", "description": "Temperatura de conservação" },
        "pageNumber": { "type": "number", "description": "Página correspondente no catálogo" },
        "suggestedPrice": { "type": "number", "description": "Preço unitário sugerido" },
        "originalPrice": { "type": "number", "description": "Preço original de referência" },
        "imageUrl": { "type": "string", "description": "URL ou DataURI da imagem do produto" },
        "highlight": { "type": "string", "description": "Selo de destaque opcional" },
        "updatedAt": { "type": "string", "description": "Data e hora da última atualização" }
      },
      "required": ["id", "name", "brand", "category", "suggestedPrice"]
    },
    "ProductCustomization": {
      "title": "ProductCustomization",
      "description": "Price and image overrides for catalog products",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "ID do produto" },
        "customPrice": { "type": "number", "description": "Novo preço configurado" },
        "customImageUrl": { "type": "string", "description": "Nova imagem configurada" },
        "updatedAt": { "type": "string", "description": "Data de atualização" }
      },
      "required": ["productId"]
    },
    "DeletedProduct": {
      "title": "DeletedProduct",
      "description": "Record of a product removed from the active catalog",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "ID do produto removido" },
        "deletedAt": { "type": "string", "description": "Data de exclusão" }
      },
      "required": ["productId", "deletedAt"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Audit log entry for stock changes",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "ID do produto alterado" },
        "productName": { "type": "string", "description": "Nome do produto" },
        "previousStock": { "type": "number", "description": "Quantidade anterior" },
        "newStock": { "type": "number", "description": "Nova quantidade" },
        "changeAmount": { "type": "number", "description": "Diferença aplicada" },
        "reason": { "type": "string", "description": "Motivo da alteração" },
        "timestamp": { "type": "string", "description": "Data e hora do registro" }
      },
      "required": ["productId", "newStock", "timestamp"]
    },
    "SalesRep": {
      "title": "SalesRep",
      "description": "Regional sales representative profile and routing settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do representante" },
        "name": { "type": "string", "description": "Nome do vendedor ou representante" },
        "code": { "type": "string", "description": "Código do RTV / vendedor" },
        "phone": { "type": "string", "description": "Telefone WhatsApp para recebimento do pedido" },
        "email": { "type": "string", "description": "E-mail de contato" },
        "regionName": { "type": "string", "description": "Nome da região / setor atendido" },
        "isActive": { "type": "boolean", "description": "Status ativo do representante" }
      },
      "required": ["id", "name", "code", "phone", "regionName"]
    },
    "Order": {
      "title": "Order",
      "description": "B2B customer order routed to sales representative and invoicing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Código identificador do pedido" },
        "status": { "type": "string", "description": "Status do pedido" },
        "createdAt": { "type": "string", "description": "Data e hora da criação do pedido" },
        "updatedAt": { "type": "string", "description": "Data da última atualização" },
        "totalVolumes": { "type": "number", "description": "Quantidade total de volumes" },
        "totalAmount": { "type": "number", "description": "Valor total estimado" },
        "finalAmount": { "type": "number", "description": "Valor final com condições comerciais" }
      },
      "required": ["id", "status", "createdAt", "totalAmount"]
    }
  },
  "firestore": {
    "/stock/{productId}": {
      "schema": "ProductStock",
      "description": "Controle de estoque em tempo real sincronizado para cada produto do catálogo"
    },
    "/custom_products/{productId}": {
      "schema": "CustomProduct",
      "description": "Produtos cadastrados ou editados individualmente pelo administrador em tempo real"
    },
    "/product_customizations/{customId}": {
      "schema": "ProductCustomization",
      "description": "Preços e fotos personalizadas de produtos sincronizados em tempo real"
    },
    "/deleted_products/{productId}": {
      "schema": "DeletedProduct",
      "description": "Registro de produtos excluídos do catálogo"
    },
    "/stock_logs/{logId}": {
      "schema": "StockLog",
      "description": "Histórico de movimentações de entrada e saída de estoque"
    },
    "/sales_reps/{repId}": {
      "schema": "SalesRep",
      "description": "Cadastro e controle dos vendedores e representantes comerciais por região"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Pedidos gerados pelos clientes para os representantes e encaminhados para emissão de nota fiscal"
    }
  }
}
